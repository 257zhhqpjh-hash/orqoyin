{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/yoz", "destination": "/yoz/index.html" },
    { "source": "/yoz/", "destination": "/yoz/index.html" },
    { "source": "/science/article00001", "destination": "/science/article00001/index.html" },
    { "source": "/science/article00001/", "destination": "/science/article00001/index.html" },
    { "source": "/science", "destination": "/science/index.html" },
    { "source": "/science/", "destination": "/science/index.html" },
    { "source": "/science/:slug", "destination": "/science/view.html" },
    { "source": "/science/:slug/", "destination": "/science/view.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
